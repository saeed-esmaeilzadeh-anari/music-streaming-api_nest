# ─── Storage provider ────────────────────────────────────────────────────────
# "local"  → LocalStorageProvider (development, no AWS credentials needed)
# "s3"     → S3StorageProvider    (production)
STORAGE_PROVIDER=local

# ─── Local provider ───────────────────────────────────────────────────────────
# Absolute path where files are saved. Defaults to <project-root>/uploads/
LOCAL_STORAGE_DIR=/absolute/path/to/uploads

# Public base URL for serving locally saved files via the static-file middleware
# Must match the express.static() mount point in main.ts
LOCAL_STORAGE_URL=http://localhost:3001/uploads

# ─── S3 provider (required when STORAGE_PROVIDER=s3) ─────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_S3_BUCKET=soundwave-media

# Optional: set this to use a non-AWS S3-compatible endpoint
# AWS S3_ENDPOINT=http://localhost:9000     # MinIO
# AWS_S3_ENDPOINT=https://<id>.r2.cloudflarestorage.com  # Cloudflare R2

# ─── App ─────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3001
PORT=3001