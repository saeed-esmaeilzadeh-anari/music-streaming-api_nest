# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
APP_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000

# PostgreSQL / Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/music_streaming?schema=public
DATABASE_POOL_SIZE=10

# Authentication (replace with independently generated random values in production)
JWT_ACCESS_SECRET=replace-with-a-random-access-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-secret-32-chars
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Redis (required by BullMQ and the cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_TTL_SECONDS=300

# File storage: local for development, s3 for production / persistent object storage
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./uploads
LOCAL_STORAGE_URL=http://localhost:3001/uploads

# Required only when STORAGE_PROVIDER=s3
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_S3_PUBLIC_BASE_URL=
AWS_S3_PRESIGNED_URL_EXPIRY_SECONDS=900

# Stripe is optional until subscription payments are enabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PREMIUM_MONTHLY=
STRIPE_PRICE_ID_PREMIUM_YEARLY=

# Demo seed credentials (development/test only; never use these defaults in production)
SEED_ADMIN_PASSWORD=
SEED_ARTIST_PASSWORD=
ALLOW_DEMO_SEED=false

# Abuse protection and logs
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
LOG_LEVEL=debug
